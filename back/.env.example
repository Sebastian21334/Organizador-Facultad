# Base de datos (Neon Postgres)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=


# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Auth
JWT_SECRET=

# Azure Communication Services (envio de mails)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# CORS - URLs del/los frontend(s) separadas por coma, sin espacios
FRONTEND_URLS=http://localhost:3001,http://localhost:4200

# Puerto (Render lo inyecta automaticamente en produccion via PORT)
PORT=3000
