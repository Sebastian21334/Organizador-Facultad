# Base de datos (Neon Postgres)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
# CA opcional para un certificado privado. No desactivar su verificación.
DB_SSL_CA=


# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Auth
JWT_SECRET=
NODE_ENV=development
# lax si frontend/API están en el mismo sitio. none solo con HTTPS y NODE_ENV=production.
COOKIE_SAME_SITE=lax
# IPs/rangos CIDR de proxies confiables separados por comas. Dejar vacío sin proxy.
# Nunca true ni un número de saltos. Verificar la cadena real del proveedor antes de configurar.
TRUST_PROXY=

# Azure Communication Services (envio de mails)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# URL pública de Tempo usada en los botones de los correos
FRONTEND_URL=http://localhost:4200

# CORS - URLs completas con http:// o https://, separadas por coma.
# Producción: https://organizador-facultad-chat.vercel.app (no solo el dominio).
FRONTEND_URLS=http://localhost:3001,http://localhost:4200

# Puerto (Render lo inyecta automaticamente en produccion via PORT)
PORT=3000
